# LLM
ANTHROPIC_API_KEY=your-anthropic-key
LLM_MODEL=claude-sonnet-4-5

# Enterprise data source (SQLAlchemy connection string)
# Examples:
#   Postgres:  postgresql+psycopg2://user:pass@host:5432/dbname
#   Snowflake: snowflake://user:pass@account/database/schema?warehouse=WH
#   SQLServer: mssql+pyodbc://user:pass@host/db?driver=ODBC+Driver+17+for+SQL+Server
# Defaults to a local demo SQLite DB if unset.
DATABASE_URL=sqlite:///data/enterprise_demo.db

# Safety / performance
MAX_ROWS_RETURNED=200
QUERY_TIMEOUT_SECONDS=30
MAX_SELF_CORRECT_ATTEMPTS=3
ALLOWED_SCHEMAS=public
